# --- ChatGPT login (one of these) ---
# Output of `npm run export-session` (base64 JSON, raw JSON, or a file path)
CHATGPT_SESSION_STATE=
# Or just the __Secure-next-auth.session-token cookie value
CHATGPT_SESSION_TOKEN=

# --- MCP transport ---
MCP_TRANSPORT=http          # http | stdio
PORT=8099
MCP_PATH=/mcp
MCP_AUTH_TOKEN=             # optional bearer token for /mcp
PUBLIC_BASE_URL=            # enables signed /files download links

# --- Browser ---
HEADLESS=false              # the Docker image runs Xvfb for headful mode
BROWSER_PROXY_SERVER=
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE=Europe/Istanbul
CHATGPT_DEFAULT_URL=        # Project / custom GPT URL for new chats
CHATGPT_CDP_URL=            # attach to an existing Chrome instead of launching one

# --- Limits ---
GENERATION_TIMEOUT_SECONDS=300
SYNC_WAIT_SECONDS=240
MAX_IMAGES_PER_JOB=4
MAX_CONCURRENT_JOBS=1
RETENTION_DAYS=14
MAX_STORAGE_MB=2048
RETURN_MODE=both            # both | image | link
