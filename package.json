{
  "name": "chatgpt-web-mcp",
  "version": "0.1.0",
  "description": "MCP server that generates and edits images through a logged-in ChatGPT web session. Streamable HTTP + stdio, Obot-ready.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "chatgpt-web-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "export-session": "tsx scripts/export-session.ts",
    "mock": "tsx test/mock/server.ts",
    "prepare": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "^5.3.0",
    "playwright-core": "1.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/UmutKDev/chatgpt-web-mcp.git"
  }
}
